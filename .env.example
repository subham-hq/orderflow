# Copy to .env for local development. With the flask command (flask run,
# flask db upgrade, ...) every value is optional locally.

# development on your computer, production on a server. The flask command
# defaults to development; anything else (gunicorn, for example) refuses to
# start until this is set.
APP_ENV=development

# Required except with the flask command in development, which falls back to
# a public development key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Defaults to a SQLite file in instance/. Required in production (Render sets
# it), where the app refuses to start without it.
# DATABASE_URL=postgresql://user:password@localhost:5432/orderflow

# Public address of the site, used in links inside emails (no trailing slash)
APP_BASE_URL=http://localhost:5000

# Email: console (prints to the terminal), resend, or smtp
MAIL_BACKEND=console
MAIL_FROM=OrderFlow <no-reply@localhost>
# MAIL_REPLY_TO=support@example.com
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# Landing-page enquiries go here; also shown in the legal pages
# CONTACT_EMAIL=hello@example.com
# LEGAL_NAME=OrderFlow

# Rate limits are kept in memory per process by default. To share them
# between processes, point this at Redis (e.g. Render Key Value):
# RATELIMIT_STORAGE_URI=redis://...

# Behind a reverse proxy (production): how many proxies add X-Forwarded-For
# PROXY_HOPS=1
