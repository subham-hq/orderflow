# Copy to .env for local development. Every value is optional locally.

# development (default), production or testing
APP_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Defaults to a SQLite file in instance/. In production, Render sets this.
# DATABASE_URL=postgresql://user:password@localhost:5432/orderflow

# Public address of the site, used in links inside emails (no trailing slash)
APP_BASE_URL=http://localhost:5000

# Email: console (prints to the terminal), resend, or smtp
MAIL_BACKEND=console
MAIL_FROM=OrderFlow <no-reply@localhost>
# MAIL_REPLY_TO=support@example.com
# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# Landing-page enquiries go here; also shown in the legal pages
# CONTACT_EMAIL=hello@example.com
# LEGAL_NAME=OrderFlow

# Rate limits are kept in memory per process by default. To share them
# between processes, point this at Redis (e.g. Render Key Value):
# RATELIMIT_STORAGE_URI=redis://...
